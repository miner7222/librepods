<?xml version="1.0" encoding="utf-8"?>
<!--
    PretendardJP is a variable font, so every weight points at the same file and
    differs only by the 'wght' axis. Apple SD Gothic Neo cannot be redistributed,
    and SF Pro carries no Hangul at all, so this covers both scripts instead.
-->
<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="100" android:fontStyle="normal" android:fontVariationSettings="'wght' 100" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="200" android:fontStyle="normal" android:fontVariationSettings="'wght' 200" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="300" android:fontStyle="normal" android:fontVariationSettings="'wght' 300" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="400" android:fontStyle="normal" android:fontVariationSettings="'wght' 400" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="500" android:fontStyle="normal" android:fontVariationSettings="'wght' 500" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="600" android:fontStyle="normal" android:fontVariationSettings="'wght' 600" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="700" android:fontStyle="normal" android:fontVariationSettings="'wght' 700" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="800" android:fontStyle="normal" android:fontVariationSettings="'wght' 800" />
    <font android:font="@font/pretendard_jp_variable" android:fontWeight="900" android:fontStyle="normal" android:fontVariationSettings="'wght' 900" />
</font-family>
