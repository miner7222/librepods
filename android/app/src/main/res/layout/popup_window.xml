<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/linear_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16.dp"
    android:background="@drawable/popup_shape"
    android:clipChildren="false"
    android:orientation="vertical">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraint_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal"
        android:paddingBottom="54dp">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/pretendard"
            android:gravity="center"
            android:text="AirPods Pro"
            android:textColor="@color/popup_text"
            android:textFontWeight="600"
            android:textSize="28sp"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <ImageButton
            android:id="@+id/close_button"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="26dp"
            android:background="@drawable/popup_button_shape"
            android:contentDescription="Close Button"
            android:src="@drawable/close"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--
        Every connection clip sits a little left of centre on its own 1050px
        canvas, so centring the view still reads as off-centre. Nudge it back by
        the average of that lean. translationX rather than a margin: the lean is
        a property of the pixels, so it must not mirror under RTL.
    -->
    <FrameLayout
        android:layout_width="353dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:clipChildren="false">

        <VideoView
            android:id="@+id/video"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="0"
            android:contentDescription="AirPods"
            android:src="@raw/airpods_pro_2_connected"
            android:translationX="4dp"
            tools:ignore="HardcodedText" />

        <!--
            What Apple shows once a bud leaves the case: the pair and the case as
            two separate renders, which is also what heads the settings screen.
            The metrics are that screen's - a 246dp row split evenly, each render
            capped at 100dp and inset 8dp - so the two read as one artwork.

            It shares the clip's slot so the card keeps its height across the
            crossfade, and carries no translationX: the lean belongs to the clip's
            pixels, not to these renders.
        -->
        <LinearLayout
            android:id="@+id/artwork"
            android:layout_width="246dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:alpha="0"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/artwork_buds"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/buds"
                android:maxHeight="100dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/airpods_4_buds" />

            <ImageView
                android:id="@+id/artwork_case"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:adjustViewBounds="true"
                android:contentDescription="@string/case_alt"
                android:maxHeight="100dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/airpods_4_case" />
        </LinearLayout>
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="353dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="14dp"
        android:clipChildren="false"
        android:translationX="4dp">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/ring_guide_combined"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.2105" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/ring_guide_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1476" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/ring_guide_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.2724" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/ring_guide_case"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.7086" />

        <LinearLayout
            android:id="@+id/combined_buds_battery_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ring_guide_combined"
            app:layout_constraintStart_toStartOf="@id/ring_guide_combined"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_gravity="center"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/combined_buds_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/combined_buds_charging_icon_outline"
                    android:layout_width="13dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_background"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/combined_buds_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_text"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/combined_buds_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/airpods"
                    android:tint="@color/popup_text" />
            </FrameLayout>

            <TextView
                android:id="@+id/combined_buds_battery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:textColor="@color/popup_text"
                android:layout_marginTop="3dp"
                android:textFontWeight="400"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/left_battery_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ring_guide_left"
            app:layout_constraintStart_toStartOf="@id/ring_guide_left"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_gravity="center"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/popup_left_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/popup_left_charging_icon_outline"
                    android:layout_width="13dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_background"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_left_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_text"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_left_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/airpods_pro_left_notification"
                    android:tint="@color/popup_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/left_battery_badge"
                    android:layout_width="14dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_l_circle_fill"
                    android:alpha="0.6"
                    android:tint="@color/popup_secondary_text" />

                <TextView
                    android:id="@+id/left_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:gravity="center"
                    android:textColor="@color/popup_text"
                    android:textFontWeight="400"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/right_battery_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ring_guide_right"
            app:layout_constraintStart_toStartOf="@id/ring_guide_right"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_gravity="center"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/popup_right_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/popup_right_charging_icon_outline"
                    android:layout_width="13dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_background"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_right_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_text"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_right_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/airpods_pro_right_notification"
                    android:tint="@color/popup_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/right_battery_badge"
                    android:layout_width="14dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_r_circle_fill"
                    android:alpha="0.6"
                    android:tint="@color/popup_secondary_text" />

                <TextView
                    android:id="@+id/right_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:gravity="center"
                    android:textColor="@color/popup_text"
                    android:textFontWeight="400"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/case_battery_cell"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="@id/ring_guide_case"
            app:layout_constraintStart_toStartOf="@id/ring_guide_case"
            app:layout_constraintTop_toTopOf="parent">

            <FrameLayout
                android:layout_width="37dp"
                android:layout_height="37dp"
                android:layout_gravity="center"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/popup_case_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/popup_case_charging_icon_outline"
                    android:layout_width="13dp"
                    android:layout_height="18dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_background"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_case_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_bolt_fill"
                    android:tint="@color/popup_text"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/popup_case_battery_icon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/airpods_pro_case_notification"
                    android:tint="@color/popup_text" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/case_battery_badge"
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_marginEnd="7dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/sf_chargingcase_wireless_fill"
                    android:tint="@color/popup_text" />

                <TextView
                    android:id="@+id/case_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/pretendard"
                    android:gravity="center"
                    android:textColor="@color/popup_text"
                    android:textFontWeight="400"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
