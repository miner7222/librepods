<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.LibrePods.AppWidget.Container"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:theme="@style/Theme.LibrePods.AppWidgetContainer"
    tools:ignore="ContentDescription,NestedWeights,UseAppTint">

    <LinearLayout
        android:id="@+id/battery_widget_surface"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:clipChildren="false"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:id="@+id/left_battery_widget_container"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/left_battery_ring_container"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/left_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/left_charging_icon_outline"
                    android:layout_width="10dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/left_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/left_battery_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/sf_airpods_pro_left"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/left_battery_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:text="100%"
                android:textColor="@color/white"
                android:textFontWeight="300"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:id="@+id/right_battery_widget_container"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/right_battery_ring_container"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/right_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/right_charging_icon_outline"
                    android:layout_width="10dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/right_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/right_battery_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/sf_airpods_pro_right"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/right_battery_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:text="100%"
                android:textColor="@color/white"
                android:textFontWeight="300"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="horizontal">

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:id="@+id/case_battery_widget_container"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/case_battery_ring_container"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/case_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/case_charging_icon_outline"
                    android:layout_width="10dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/case_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/case_battery_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/sf_airpods_pro_chargingcase_wireless_fill"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/case_battery_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:text="84%"
                android:textColor="@color/white"
                android:textFontWeight="300"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />

        <LinearLayout
            android:id="@+id/phone_battery_widget_container"
            android:layout_width="65dp"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:id="@+id/phone_battery_ring_container"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:clipChildren="false">

                <ImageView
                    android:id="@+id/phone_battery_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <ImageView
                    android:id="@+id/phone_charging_icon_outline"
                    android:layout_width="10dp"
                    android:layout_height="17dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/phone_charging_icon"
                    android:layout_width="11dp"
                    android:layout_height="18dp"
                    android:layout_gravity="top|center_horizontal"
                    android:layout_marginTop="-5dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_power"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/phone_battery_icon"
                    android:layout_width="27dp"
                    android:layout_height="27dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/sf_iphone_gen3"
                    android:tint="@color/white" />
            </FrameLayout>

            <TextView
                android:id="@+id/phone_battery_widget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/pretendard"
                android:gravity="center"
                android:text="97%"
                android:textColor="@color/white"
                android:textFontWeight="300"
                android:textSize="20sp"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="1dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            tools:ignore="UselessLeaf" />
    </LinearLayout>
</RelativeLayout>
